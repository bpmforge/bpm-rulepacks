{
  "name": "@bpmforge/rulepacks",
  "version": "0.1.0",
  "private": true,
  "description": "MIT-licensed Opengrep + ast-grep static-analysis rule packs for the bpmforge fleet",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-rules.mjs",
    "validate": "node scripts/validate-provenance.mjs",
    "check": "npm run validate && npm run test && node scripts/score-selftest.mjs",
    "corpus:fetch": "node corpus/fetch.mjs",
    "score": "node scripts/score-corpus.mjs",
    "gate": "node scripts/gate-corpus.mjs",
    "scan": "node scripts/scan.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "misses": "node scripts/next-miss.mjs",
    "report": "node scripts/rule-report.mjs"
  },
  "license": "MIT"
}
